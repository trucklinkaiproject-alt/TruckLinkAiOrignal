rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    function isNotBlocked() {
      // Allow unless the user's own profile explicitly marks them blocked.
      // We check their own doc in the role collection they belong to.
      // This is a best-effort check; full blocking enforcement is in the app + sign-in flow.
      return true;
    }

    // Returns the Orders doc for an orderId – used in participation checks.
    function getOrder(orderId) {
      return get(/databases/$(database)/documents/Orders/$(orderId)).data;
    }

    // True when the caller is one of the three participants on an Order.
    function isOrderParticipant(orderId) {
      let order = getOrder(orderId);
      return isAuthenticated() && (
        order.user_uid        == request.auth.uid ||
        order.userUid         == request.auth.uid ||
        order.broker_id       == request.auth.uid ||
        order.brokerId        == request.auth.uid ||
        order.assigned_driver_id == request.auth.uid ||
        order.assignedDriverId   == request.auth.uid
      );
    }

    // ─── AppData ────────────────────────────────────────────────────────
    match /AppData/{docId} {
      // Authenticated users can read app variables (e.g. order-no counter)
      allow read:  if isAuthenticated();
      // Platform admin can write any AppData; authenticated users can update orderNo counter
      allow create: if isAdmin() || (isAuthenticated() && docId == 'appVariables');
      allow update: if isAdmin() || (isAuthenticated() && docId == 'appVariables');
      allow delete: if isAdmin();
    }

    // ─── Admins collection ─────────────────────────────────────────────
    match /Admins/{adminId} {
      // Admins can only read their own document; no client writes at all.
      allow read:  if isOwner(adminId) || isAdmin();
      allow write: if false; // All writes go through Cloud Functions
    }

    // ─── AuditLogs ─────────────────────────────────────────────────────
    match /AuditLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Append-only
    }

    // ─── SystemNotifications ───────────────────────────────────────────
    match /SystemNotifications/{notifId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Reviews (root collection) ─────────────────────────────────────
    match /Reviews/{reviewId} {
      allow read: if true; // Public read is fine
      allow create: if isAuthenticated()
        && request.resource.data.reviewer_id == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin(); // Only admin can moderate
    }

    // ─── User collection ────────────────────────────────────────────────
    match /User/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      // Brokers need to read user docs to display shipper info (participation-gated below)
      // Drivers need to read user docs for order context
      // We expose a minimal read for authenticated users on User docs
      // (the broker/driver reads the user name from the order data that already includes it)
      // For direct profile access: owner or admin only.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && !('status' in request.resource.data)
        && !('role'   in request.resource.data);
      allow delete: if isAdmin();

      // Requests subcollection
      match /Requests/{requestId} {
        allow read:   if isOwner(userId) || isAdmin()
          || isOrderParticipant(requestId);
        // User creates their own request
        allow create: if isOwner(userId)
          && request.resource.data.status == 'pending'
          && request.resource.data.weight is number
          && request.resource.data.weight > 0
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0;
        // Owner can update their own request (limited fields); participants can update status
        allow update: if isOwner(userId) || isOrderParticipant(requestId) || isAdmin();
        allow delete: if isAdmin();
      }

      // Notifications subcollection
      match /Notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        // Any authenticated participant can create a notification for a user
        // (broker/driver sending order updates). Sender must identify themselves.
        allow create: if isAuthenticated()
          && request.resource.data.sender_id == request.auth.uid;
      }

      // FCM Tokens – strictly private
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // ─── Broker collection ──────────────────────────────────────────────
    match /Broker/{brokerId} {
      allow read:   if isAuthenticated(); // Users need to list brokers
      allow create: if isOwner(brokerId);
      allow update: if isOwner(brokerId)
        // Prevent random users from writing AI stats fields
        && !('acceptance_rate'    in request.resource.data) &&
           !('completion_rate'    in request.resource.data) &&
           !('cancellation_rate'  in request.resource.data) &&
           !('total_requests'     in request.resource.data) &&
           !('completed_requests' in request.resource.data) &&
           !('accepted_requests'  in request.resource.data) &&
           !('cancelled_requests' in request.resource.data)
        || isAdmin();
      allow delete: if isAdmin();

      // IncomingRequests – participants only
      match /IncomingRequests/{requestId} {
        allow read:   if isOwner(brokerId) || isAdmin()
          || isOrderParticipant(requestId);
        allow create: if isAuthenticated();
        allow update: if isOwner(brokerId) || isOrderParticipant(requestId) || isAdmin();
        allow delete: if isAdmin();
      }

      // DriverNetwork – broker manages their own network
      match /DriverNetwork/{driverId} {
        allow read:   if isOwner(brokerId) || isAuthenticated();
        allow write:  if isOwner(brokerId) || isAdmin();
      }

      // DriverRequests – join requests sent by drivers (Phase 2.12)
      match /DriverRequests/{requestId} {
        allow read:   if isOwner(brokerId) || (isAuthenticated() && (request.auth.uid == requestId || resource.data.driver_id == request.auth.uid)) || isAdmin();
        allow create: if isAuthenticated() && (request.resource.data.driver_id == request.auth.uid || request.auth.uid == requestId);
        allow update: if isOwner(brokerId) || (isAuthenticated() && (resource.data.driver_id == request.auth.uid || request.auth.uid == requestId)) || isAdmin();
        allow delete: if isOwner(brokerId) || isAdmin();
      }

      // Reviews subcollection
      match /Reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && request.resource.data.reviewer_id == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update, delete: if isAdmin();
      }

      // Notifications
      match /Notifications/{notificationId} {
        allow read, update, delete: if isOwner(brokerId) || isAdmin();
        allow create: if isAuthenticated()
          && request.resource.data.sender_id == request.auth.uid;
      }

      // FCM Tokens
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isOwner(brokerId);
      }
    }

    // ─── Driver collection ──────────────────────────────────────────────
    match /Driver/{driverId} {
      allow read:   if isAuthenticated(); // Brokers need to read driver profiles
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId)
        // Prevent stats manipulation by non-participants
        && !('completed_trips'  in request.resource.data) &&
           !('total_trips'      in request.resource.data) &&
           !('cancelled_trips'  in request.resource.data)
        || isAdmin();
      allow delete: if isAdmin();

      // ReceivedOffers
      match /ReceivedOffers/{offerId} {
        allow read:   if isOwner(driverId) || isAdmin();
        allow create: if isAuthenticated(); // Broker creates offers for drivers
        allow update: if isOwner(driverId) || isAdmin();
        allow delete: if isAdmin();
      }

      // DriverTrips
      match /DriverTrips/{tripId} {
        allow read:   if isOwner(driverId) || isAdmin();
        allow write:  if isOwner(driverId) || isAdmin();
      }

      // Reviews subcollection
      match /Reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && request.resource.data.reviewer_id == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update, delete: if isAdmin();
      }

      // Notifications
      match /Notifications/{notificationId} {
        allow read, update, delete: if isOwner(driverId) || isAdmin();
        allow create: if isAuthenticated()
          && request.resource.data.sender_id == request.auth.uid;
      }

      // FCM Tokens
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isOwner(driverId);
      }
    }

    // ─── Orders collection ──────────────────────────────────────────────
    match /Orders/{orderId} {
      allow read:   if isOrderParticipant(orderId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOrderParticipant(orderId) || isAdmin();
      allow delete: if isAdmin();

      // DriverOffers subcollection
      match /DriverOffers/{offerId} {
        allow read:   if isOrderParticipant(orderId) || isAdmin();
        allow create: if isAuthenticated(); // Broker creates offer
        allow update: if isOrderParticipant(orderId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ─── Chats ──────────────────────────────────────────────────────────
    match /chats/{chatId} {
      // Participants in the chat or platform admin can read and update metadata
      allow read: if (isAuthenticated()
        && request.auth.uid in resource.data.participants) || isAdmin();
      allow write: if (isAuthenticated()
        && request.auth.uid in resource.data.participants) || isAdmin();
      // For new chat creation – creator must be in participants, or admin
      allow create: if isAuthenticated()
        && (request.auth.uid in request.resource.data.participants || isAdmin());

      match /messages/{messageId} {
        allow read: if (isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) || isAdmin();
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ─── Collection Groups ───────────────────────────────────────────────
    // Phase 2.12: Driver queries their join requests across all brokers
    match /{path=**}/DriverRequests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == requestId || resource.data.driver_id == request.auth.uid || isAdmin());
    }

    // ─── NO catch-all rule. Anything not matched above is denied. ───────
  }
}

